# ==============================================================================
# Git Ignore Rules: Dual-Camera Helmet Violation Detection Research
# ==============================================================================

# Python Bytecode & Compilation Artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.coverage.*

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Environment & Secret Files
.env
.env.*
!.env.example

# Large ML Model Weights & Checkpoints
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.mlmodel
*.ckpt
*.h5
*.pb
*.weights
*.bin
yolov8*.pt

# Datasets (Images, Annotations, Processed Artifacts)
# Note: Reproducibility metadata in data/metadata/ and data/splits/ is preserved
data/annotated/
data/processed/
data/raw/*.jpg
data/raw/*.png
data/raw/*.mp4
data/raw/*.avi
*.mp4
*.MOV
*.mov
*.avi
*.mkv
*.wav
Motorcycle synchronization/
data/dual_camera_test_v1/front/*.mp4
data/dual_camera_test_v1/back/*.mp4
data/dual_camera_test_v1/unmatched_quarantine/*.mp4
results/phase11_dual_camera/audio_cache/

# Generated Training Dumps, Evaluation Runs & Batch Visualizations
results/evaluation/
results/plots/
results/confusion_matrices/
experiments/**/training/
experiments/**/weights/
models/checkpoints/
models/final/
results/predictions/

# Preserve Directory Architecture with .gitkeep
!models/.gitkeep
!results/.gitkeep
!experiments/.gitkeep
!data/raw/.gitkeep
!data/metadata/.gitkeep
!data/splits/.gitkeep

# Raw Kaggle Download Dumps
results/phase9_multiseed/kaggle_outputs_*/

# Blind GT v1.1 Review Dashboard local runtime workspace & caches
data/dual_camera_test_v1/releases/dual_camera_gt_v1.1_blind_human/review_workspace/*.sqlite3*
data/dual_camera_test_v1/releases/dual_camera_gt_v1.1_blind_human/review_workspace/submissions/
data/dual_camera_test_v1/releases/dual_camera_gt_v1.1_blind_human/review_workspace/adjudications/
data/dual_camera_test_v1/releases/dual_camera_gt_v1.1_blind_human/review_workspace/snapshots/
data/dual_camera_test_v1/releases/dual_camera_gt_v1.1_blind_human/review_workspace/exports/
data/dual_camera_test_v1/releases/dual_camera_gt_v1.1_blind_human/review_workspace/backups/
data/dual_camera_test_v1/releases/dual_camera_gt_v1.1_blind_human/review_workspace/.proxy_cache/

